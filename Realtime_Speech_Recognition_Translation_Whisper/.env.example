# Environment Variables Template for Whisper Real-time Translator
# Copy this file to .env and fill in your values

# Weights & Biases Configuration
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=whisper-realtime-translation
WANDB_ENTITY=your_wandb_username_or_team

# Model Configuration
WHISPER_MODEL_ID=openai/whisper-large-v3
DEVICE=auto  # Options: auto, cuda, cuda:0, cpu

# Translation Configuration
TARGET_LANGUAGE=es  # ISO 639-1 language codes (es, fr, de, it, pt, ru, ja, zh, ko, ar, etc.)

# Audio Configuration
SAMPLE_RATE=16000  # Audio sample rate in Hz
CHUNK_DURATION=5.0  # Duration of audio chunks in seconds

# Optional: HuggingFace Token (for private models)
# HF_TOKEN=your_huggingface_token_here

# Optional: Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
